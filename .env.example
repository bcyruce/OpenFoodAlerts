# Copy to .env and adjust. .env is git-ignored; never commit real secrets.

# Pipeline (owner role locally; ofa_pipeline in production)
DATABASE_URL=postgres://ofa:ofa@localhost:5432/ofa?sslmode=disable
# Separate database used by DB-backed tests (created by `make test-db`)
TEST_DATABASE_URL=postgres://ofa:ofa@localhost:5432/ofa_test?sslmode=disable

# Website: read-only role ofa_web (spec §11.2). `make db-roles` enables its login with
# OFA_WEB_PASSWORD; the placeholder below is for local development only.
OFA_WEB_PASSWORD=ofa_web_local
WEB_DATABASE_URL=postgres://ofa_web:ofa_web_local@localhost:5432/ofa?sslmode=disable
# Public site URL (canonical and Open Graph links) and repository ("report an error")
SITE_URL=https://openfoodalerts.nl
OFA_REPO_URL=https://github.com/bcyruce/OpenFoodAlerts

# dbmate
DBMATE_MIGRATIONS_DIR=db/migrations

# openFDA API key (free, https://open.fda.gov/apis/authentication/)
OPENFDA_API_KEY=
