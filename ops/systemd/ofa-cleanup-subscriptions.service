# OpenFoodAlerts (ticket 34). Installed to /etc/systemd/system/; see docs/runbook.md.
[Unit]
Description=OpenFoodAlerts: delete expired subscription data (pending 7 d, unsubscribed 29 d, deliveries 12 months)
Documentation=file:/opt/openfoodalerts/current/docs/runbook.md
Wants=network-online.target
After=network-online.target postgresql.service
OnSuccess=ofa-heartbeat@%N.service
OnFailure=ofa-heartbeat-fail@%N.service

[Service]
Type=oneshot
User=ofa-mailer
Group=ofa-mailer
SupplementaryGroups=ofa-jobs
# Database role ofa_mailer (spec §11.2); file is root:root mode 600, read by systemd only.
EnvironmentFile=/etc/openfoodalerts/mailer.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WorkingDirectory=/opt/openfoodalerts/current/pipeline
# Locks (ops/bin/ofa-run): one network job per Source, one writer of Notifications,
# one mailer job at a time. systemd itself never runs two copies of this unit.
ExecStart=/opt/openfoodalerts/current/ops/bin/ofa-run -l mail -- cleanup-subscriptions
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ReadWritePaths=/run/lock/openfoodalerts
# Hardening: the job can write only to the lock directory (and the network).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0077
