# OpenFoodAlerts (ticket 34). Installed to /etc/systemd/system/; see docs/runbook.md.
[Unit]
Description=OpenFoodAlerts timer: encrypted pg_dump to off-site object storage
Documentation=file:/opt/openfoodalerts/current/docs/runbook.md

[Timer]
# nightly (spec §5 backup).
OnCalendar=*-*-* 02:30:00 Europe/Amsterdam
RandomizedDelaySec=15min
# Same offset on every run on this host, so the load on the Source stays predictable.
FixedRandomDelay=true
# Catch up a run that was missed while the server was off.
Persistent=true
Unit=ofa-backup.service

[Install]
WantedBy=timers.target
