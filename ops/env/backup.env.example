# /etc/openfoodalerts/backup.env (root:root, mode 600). Names only: no real values here.
# Read by systemd for ofa-backup and ofa-backup-ledger (throwaway DynamicUser).

# Read-only role ofa_backup (member of pg_read_all_data), created by the bootstrap script.
BACKUP_DATABASE_URL=postgres://ofa_backup:__PASSWORD__@127.0.0.1:5432/ofa?sslmode=disable

# age PUBLIC keys (space-separated). Two recommended: your laptop key and an offline
# recovery key. The private keys must never be on this server.
BACKUP_AGE_RECIPIENTS=

# rclone destination: <remote>:<bucket>/<path>. The remote is defined below through
# rclone's environment variables (RCLONE_CONFIG_<NAME>_<OPTION>, NAME upper-case).
BACKUP_REMOTE=ofabackup:openfoodalerts-backups/prod
BACKUP_KEEP_DAYS=30
BACKUP_KEEP_MIN=7

# Example: S3-compatible object storage (Scaleway nl-ams, Hetzner, ...). Use a key that can
# only reach this bucket. Values come from the provider's console.
RCLONE_CONFIG_OFABACKUP_TYPE=s3
RCLONE_CONFIG_OFABACKUP_PROVIDER=Other
RCLONE_CONFIG_OFABACKUP_ENDPOINT=
RCLONE_CONFIG_OFABACKUP_REGION=
RCLONE_CONFIG_OFABACKUP_ACCESS_KEY_ID=
RCLONE_CONFIG_OFABACKUP_SECRET_ACCESS_KEY=
RCLONE_CONFIG_OFABACKUP_NO_CHECK_BUCKET=true

# Alternative: an SFTP target such as a Hetzner Storage Box (comment out the S3 lines).
# RCLONE_CONFIG_OFABACKUP_TYPE=sftp
# RCLONE_CONFIG_OFABACKUP_HOST=
# RCLONE_CONFIG_OFABACKUP_USER=
# RCLONE_CONFIG_OFABACKUP_PORT=23
# RCLONE_CONFIG_OFABACKUP_KEY_FILE=/etc/openfoodalerts/backup-ssh-key
# RCLONE_CONFIG_OFABACKUP_KNOWN_HOSTS_FILE=/etc/openfoodalerts/backup-known-hosts
