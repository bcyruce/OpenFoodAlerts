# /etc/openfoodalerts/web.env (root:root, mode 600). Names only: no real values here.
# Read by systemd for ofa-web.service (user ofa-web) and, by ofa-deploy, for `next build`
# (the build prerenders pages from the database). systemd syntax: KEY=value.

# Database role ofa_web (spec §11.2): read-only public tables, read/write subscriptions.
WEB_DATABASE_URL=postgres://ofa_web:__PASSWORD__@127.0.0.1:5432/ofa?sslmode=disable

# Canonical site URL and repository ("report an error" links).
SITE_URL=https://openfoodalerts.nl
OFA_REPO_URL=https://github.com/bcyruce/OpenFoodAlerts
SNELVINK_URL=https://snelvink.nl
# Footer name when web/lib/legal.ts has none yet (read at build time).
OWNER_NAME=

# Subscription secrets (implementation-log ### 28). Same values as in mailer.env.
# OFA_HASH_PEPPER keys the do-not-send list: NEVER change it once there are suppressions.
# OFA_TOKEN_SECRET keys every manage link: changing it breaks all links (see runbook).
OFA_HASH_PEPPER=__SECRET__
OFA_TOKEN_SECRET=__SECRET__

# Confirmation emails.
EMAIL_TRANSPORT=brevo
BREVO_API_KEY=
EMAIL_FROM=noreply@openfoodalerts.nl
EMAIL_FROM_NAME=OpenFoodAlerts

# nginx overwrites both X-Real-IP and X-Forwarded-For with the connecting address
# (ops/nginx/openfoodalerts.conf), so either header is safe; X-Real-IP as advised in ### 28.
CLIENT_IP_HEADER=x-real-ip
SUBSCRIBE_RATE_LIMIT=5/600
CONFIRM_RATE_LIMIT=20/600
MANAGE_RATE_LIMIT=60/600
