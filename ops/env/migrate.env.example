# /etc/openfoodalerts/migrate.env (root:root, mode 600). Names only: no real values here.
# Used only by ofa-deploy: dbmate migrations and `ofa load-seeds` run as the owner role.
# Always the same owner role: the migrations' ALTER DEFAULT PRIVILEGES only cover objects
# created by the role that ran them (db/migrations/20261025000350_roles.sql).
DATABASE_URL=postgres://ofa:__PASSWORD__@127.0.0.1:5432/ofa?sslmode=disable
