# /etc/openfoodalerts/heartbeat.env (root:root, mode 600). Optional; names only.
# Read by ofa-heartbeat@ / ofa-heartbeat-fail@ (ops/bin/ofa-heartbeat).

# Healthchecks.io-style ping base with the project's ping key:
#   https://hc-ping.com/<ping-key>     (each job pings <base>/<job> and <base>/<job>/fail)
OFA_HEARTBEAT_BASE=
# 1 = create a check on its first ping; set period and grace afterwards (runbook table).
OFA_HEARTBEAT_CREATE=1
