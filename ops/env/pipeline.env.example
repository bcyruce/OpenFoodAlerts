# /etc/openfoodalerts/pipeline.env (root:root, mode 600). Names only: no real values here.
# Read by systemd for the ofa-ingest-*, ofa-refresh-rasff, ofa-probe-contracts,
# ofa-check-data and ofa-seed-rasff-lookups units (user ofa-pipeline). systemd syntax:
# KEY=value, no `export`, no shell expansion. ops/bootstrap/init-db-and-secrets.sh fills
# the database password; the API keys are yours to add.

# Database role ofa_pipeline (spec §11.2): every table except the private subscription tables.
# Password: hex only (URL-safe), generated by the bootstrap script.
DATABASE_URL=postgres://ofa_pipeline:__PASSWORD__@127.0.0.1:5432/ofa?sslmode=disable

# openFDA API key (free; 120,000 requests/day instead of 1,000). Optional but recommended.
OPENFDA_API_KEY=

# Model API key for `ofa classify` (tickets 16-18). The exact variable name is set by
# ticket 16; ANTHROPIC_API_KEY is what the Anthropic SDK reads by default.
ANTHROPIC_API_KEY=
