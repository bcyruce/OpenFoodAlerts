# /etc/openfoodalerts/mailer.env (root:root, mode 600). Names only: no real values here.
# Read by systemd for ofa-send-digest, ofa-send-instant and ofa-cleanup-subscriptions
# (user ofa-mailer). systemd syntax: KEY=value, no `export`, no shell expansion.

# Database role ofa_mailer (spec §11.2): sees Subscriptions only through the
# sendable_subscriptions view; deletes only through cleanup_subscriptions().
# DATABASE_URL is set to the same mailer URL on purpose: a mailer job that forgets
# MAILER_DATABASE_URL must never fall back to a more powerful role.
MAILER_DATABASE_URL=postgres://ofa_mailer:__PASSWORD__@127.0.0.1:5432/ofa?sslmode=disable
DATABASE_URL=postgres://ofa_mailer:__PASSWORD__@127.0.0.1:5432/ofa?sslmode=disable

# Must be byte-for-byte the same values as in web.env (implementation-log ### 28, ### 29).
# OFA_TOKEN_SECRET: the mailer rebuilds manage/unsubscribe links from it.
# OFA_HASH_PEPPER: NEVER change it once there are suppressions; never rotate either casually.
OFA_TOKEN_SECRET=__SECRET__
OFA_HASH_PEPPER=__SECRET__

# Links in the emails.
SITE_URL=https://openfoodalerts.nl

# Brevo (transactional API). Confirm the variable names against tickets 30/31 when merged.
EMAIL_TRANSPORT=brevo
BREVO_API_KEY=
EMAIL_FROM=noreply@openfoodalerts.nl
EMAIL_FROM_NAME=OpenFoodAlerts
